{
  "manifest_version": 3,
  "name": "DuoFollow Connector",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://www.duolingo.com/*"],
  "action": {
    "default_title": "__MSG_accessAction__",
    "default_icon": "icons/icon-32.png"
  },
  "options_ui": {
    "page": "access.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["https://hedgerock.github.io/*"]
  }
}
