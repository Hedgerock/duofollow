{
  "manifest_version": 3,
  "name": "DuoFollow Connector",
  "version": "0.1.0",
  "description": "Находит невзаимные подписки в Duolingo через DuoFollow и помогает отписаться от выбранного профиля после подтверждения.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["https://www.duolingo.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["https://hedgerock.github.io/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
