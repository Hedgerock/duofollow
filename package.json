{
  "name": "duofollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:integration": "playwright test --project=integration",
    "test:edge": "playwright test --config=playwright.edge.config.ts",
    "test:load": "playwright test --config=playwright.load.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:browser:docker": "docker compose -f compose.test.yml run --build --rm browser-tests",
    "test:browser:docker:update-snapshots": "docker compose -f compose.test.yml run --build --rm browser-tests --project=visual --update-snapshots=all",
    "test:load:docker": "docker compose -f compose.test.yml run --build --rm browser-tests --config=playwright.load.config.ts",
    "test:firefox": "playwright test --config=playwright.firefox.config.ts",
    "extension:firefox:build": "node extension/scripts/build.mjs --firefox",
    "extension:firefox:lint": "npm run extension:firefox:build && web-ext lint --source-dir extension/dist-firefox --warnings-as-errors",
    "extension:firefox:run": "npm run extension:firefox:build && web-ext run --source-dir extension/dist-firefox",
    "extension:firefox:zip": "node extension/scripts/build.mjs --firefox --zip",
    "test:firefox:extension": "node scripts/test-firefox-extension.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.25.12",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "playwright": "1.57.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "^6.3.0",
    "vitest": "4.1.12",
    "web-ext": "10.8.0"
  }
}
