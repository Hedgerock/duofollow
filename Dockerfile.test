# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/playwright:v1.57.0-noble

WORKDIR /workspace
ENV CI=true \
    VITE_DUOFOLLOW_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop \
    VITE_DUOFOLLOW_EDGE_EXTENSION_ID=ponmlkjihgfedcbaponmlkjihgfedcba

# Dependency installation is cached independently of source and test changes.
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --prefer-offline

COPY tsconfig.json vite.config.ts playwright*.config.ts eslint.config.js index.html LICENSE ./
COPY src ./src
COPY extension ./extension
COPY public ./public
COPY e2e ./e2e
COPY privacy ./privacy
COPY access ./access
COPY settings ./settings
COPY scripts ./scripts

# Compilation finishes before any browser worker starts.
RUN npm run build && npm --prefix extension run build \
    && mkdir -p test-results e2e/snapshots
ENV DUOFOLLOW_TEST_PREBUILT=1
