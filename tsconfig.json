{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "chrome", "node"],
    "paths": {
      "@duofollow/*": ["./*"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "playwright.load.config.ts"]
}
