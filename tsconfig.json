{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "chrome", "firefox-webext-browser", "node"],
    "paths": {
      "@duofollow/*": ["./*"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright*.config.ts"]
}
